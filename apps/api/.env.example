NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string
# App connects as a non-superuser so row-level security is enforced
DATABASE_URL=postgres://tutionassist_app:tutionassist_app@localhost:5432/tutionassist
# Migrations run as the DB owner
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/tutionassist
REDIS_URL=redis://localhost:6379
